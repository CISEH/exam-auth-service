# ---- Server ----
PORT=4001
NODE_ENV=development
# Browser origins allowed to call the auth endpoints (admin UI + exam portal UI)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ---- PostgreSQL (same database as exam-hub-api) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/exam_hub
PGSSL=false
PG_POOL_MAX=10

# ---- Tokens ----
# "iss" claim; APIs must check it
AUTH_ISSUER=exam-auth-service
# Folder holding the RS256 key pairs (keys/<portal>/<kid>.key.pem). Never commit it.
KEYS_DIR=./keys

# Per-portal lifetimes: 30s, 15m, 12h, 7d ...
ADMIN_ACCESS_TTL=15m
ADMIN_REFRESH_IDLE_TTL=12h
ADMIN_SESSION_MAX_TTL=7d
EXAM_ACCESS_TTL=10m
EXAM_REFRESH_IDLE_TTL=2h
EXAM_SESSION_MAX_TTL=8h

# ---- Login protection ----
# per account within the window
LOGIN_MAX_FAILURES=5
# per IP within the window
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_WINDOW=15m

# ---- Refresh-token cookie (optional) ----
# true = also send the refresh token as an HttpOnly cookie (recommended for browsers)
REFRESH_TOKEN_COOKIE=false
# true in production (HTTPS)
COOKIE_SECURE=false
# lax | strict | none (none requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# ---- Introspection (service-to-service) ----
# Portal APIs send this in the x-api-key header to POST /api/introspect.
# Leave empty to disable the endpoint.
INTROSPECT_API_KEY=change-me-to-a-long-random-string
