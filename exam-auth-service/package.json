{
  "name": "exam-auth-service",
  "version": "1.0.0",
  "description": "Central authentication service for the Exam Hub admin portal and the student exam portal (RS256 JWT + refresh-token sessions)",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "keys:generate": "node scripts/keys.js generate",
    "keys:rotate": "node scripts/keys.js rotate",
    "keys:list": "node scripts/keys.js list"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  }
}
